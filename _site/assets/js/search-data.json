ttp://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"> <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line> </svg> </symbol> <!-- Bootstrap Icons. MIT License: https://github.com/twbs/icons/blob/main/LICENSE.md --> <symbol id="svg-copy" viewBox="0 0 16 16"> <title>Copy</title> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard" viewBox="0 0 16 16"> <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/> <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/> </svg> </symbol> <symbol id="svg-copied" viewBox="0 0 16 16"> <title>Copied</title> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard-check-fill" viewBox="0 0 16 16"> <path d="M6.5 0A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3Zm3 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3Z"/> <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1A2.5 2.5 0 0 1 9.5 5h-3A2.5 2.5 0 0 1 4 2.5v-1Zm6.854 7.354-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L7.5 10.793l2.646-2.647a.5.5 0 0 1 .708.708Z"/> </svg> </symbol> </svg> <div class="side-bar"> <div class="site-header" role="banner"> <a href="/" class="site-title lh-tight"> scheng </a> <button id="menu-button" class="site-button btn-reset" aria-label="Toggle menu" aria-pressed="false"> <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use xlink:href="#svg-menu"></use></svg> </button> </div> <nav aria-label="Main" id="site-nav" class="site-nav"> <ul class="nav-list"><li class="nav-list-item"><a href="/" class="nav-list-link">Home</a></li><li class="nav-list-item"><a href="/architecture/" class="nav-list-link">Architecture</a></li><li class="nav-list-item"><a href="/getting-started/" class="nav-list-link">Getting Started</a></li><li class="nav-list-item"><button class="nav-list-expander btn-reset" aria-label="toggle items in SDK category" aria-pressed="false"> <svg viewBox="0 0 24 24" aria-hidden="true"><use xlink:href="#svg-arrow-right"></use></svg> </button><a href="/sdk/" class="nav-list-link">SDK</a><ul class="nav-list"><li class="nav-list-item"><a href="/sdk/" class="nav-list-link">Overview</a></li><li class="nav-list-item"><a href="/sdk/pipeline" class="nav-list-link">Pipeline</a></li><li class="nav-list-item"><a href="/sdk/crate-map/" class="nav-list-link">Crate Map</a></li><li class="nav-list-item"><a href="/sdk/graph-api/" class="nav-list-link">Graph API</a></li><li class="nav-list-item"><a href="/sdk/node-kinds/" class="nav-list-link">Node Kinds</a></li><li class="nav-list-item"><a href="/sdk/node-props/" class="nav-list-link">NodeProps Reference</a></li><li class="nav-list-item"><a href="/sdk/shader-contract/" class="nav-list-link">Shader Contract</a></li><li class="nav-list-item"><a href="/sdk/runtime-execution/" class="nav-list-link">Runtime Execution</a></li><li class="nav-list-item"><a href="/sdk/per-frame-execution-lifecycle/" class="nav-list-link">Per Frame Execution Lifecycle</a></li><li class="nav-list-item"><a href="/sdk/osc-contract/" class="nav-list-link">OSC Contract</a></li><li class="nav-list-item"><a href="/sdk/known-constraints/" class="nav-list-link">Known Constraints and Non-Goals</a></li></ul></li><li class="nav-list-item"><button class="nav-list-expander btn-reset" aria-label="toggle items in Examples category" aria-pressed="false"> <svg viewBox="0 0 24 24" aria-hidden="true"><use xlink:href="#svg-arrow-right"></use></svg> </button><a href="/examples/" class="nav-list-link">Examples</a><ul class="nav-list"></ul></li><li class="nav-list-item"><a href="/glossary/" class="nav-list-link">Glossary</a></li><li class="nav-list-item"><a href="/core-concepts/" class="nav-list-link">Core Concepts</a></li></ul> </nav> <footer class="site-footer"> This site uses <a href="https://github.com/just-the-docs/just-the-docs">Just the Docs</a>, a documentation theme for Jekyll. </footer> </div> <div class="main" id="top"> <div id="main-header" class="main-header"> <div class="search" role="search"> <div class="search-input-wrap"> <input type="text" id="search-input" class="search-input" tabindex="0" placeholder="Search scheng" aria-label="Search scheng" autocomplete="off"> <label for="search-input" class="search-label"><svg viewBox="0 0 24 24" class="search-icon"><use xlink:href="#svg-search"></use></svg></label> </div> <div id="search-results" class="search-results"></div> </div> </div> <div class="main-content-wrap"> <div id="main-content" class="main-content"> <main> <h{"0": { "doc": "Architecture", "title": "Architecture", "content": "scheng enables developers to construct programmable video instruments. Rather than being a fixed VJ application, scheng is an engine and SDK for building custom video instruments with predictable execution behavior. It provides a graph-based execution model, explicit shader and node contracts, and a modular SDK surface for building deterministic, extensible visual systems. ", "url": "/architecture/", "relUrl": "/architecture/" },"1": { "doc": "Architecture", "title": "Architecture at a Glance", "content": "scheng is organized as a multi-crate workspace that separates responsibilities into clearly defined layers. Each layer exists to reduce ambiguity, preserve determinism, and allow independent evolution without breaking runtime guarantees. ", "url": "/architecture/#architecture-at-a-glance", "relUrl": "/architecture/#architecture-at-a-glance" },"2": { "doc": "Architecture", "title": "Layers", "content": "Each layer is intentionally isolated to enforce clarity, extensibility, and real-time safety. | Graph Layer –&gt; Declarative signal topology and node relationships. | Runtime Layer –&gt; Frame planning and deterministic execution. | Shader Contracts –&gt; Explicit interfaces between nodes and GPU forms. | Control Inputs –&gt; OSC, keyboard, transport, and external state. | Output Targets –&gt; Render targets and external integrations. | . ", "url": "/architecture/#layers", "relUrl": "/architecture/#layers" },"3": { "doc": "Architecture", "title": "1. Graph Layer", "content": "Declarative signal topology and node relationships. The Graph Layer defines what connects to what. It is purely structural — no GPU work happens here. Developers declare nodes, their inputs and outputs, and how signals flow between them. The graph is a topology description of a visual instrument. Key properties: . | No frame timing logic | No rendering logic | No control handling | Only topology and node relationships | . This separation ensures that signal structure remains stable and inspectable before execution. ", "url": "/architecture/#1-graph-layer", "relUrl": "/architecture/#1-graph-layer" },"4": { "doc": "Architecture", "title": "2. Runtime Layer", "content": "Frame planning and deterministic execution. The Runtime Layer defines when and how the graph executes. For every frame: . | A plan is generated | Node execution order is resolved | Resources are prepared | Execution proceeds deterministically | . The runtime guarantees: . | Stable ordering | No implicit side effects | Real-time safety boundaries | Frame-by-frame predictability | . The graph defines structure. The runtime defines execution. ", "url": "/architecture/#2-runtime-layer", "relUrl": "/architecture/#2-runtime-layer" },"5": { "doc": "Architecture", "title": "3. Shader Contracts", "content": "Explicit interfaces between nodes and GPU forms. Shader Contracts define what a node promises. Every node exposes: . | Required inputs | Produced outputs | Parameter interfaces | Expected texture formats | . This prevents implicit coupling between nodes and makes GPU execution explicit and testable. Contracts are not implementation — they are agreements. They allow: . | Node composability | Validation before execution | Safe extensibility | Clear SDK boundaries | . ", "url": "/architecture/#3-shader-contracts", "relUrl": "/architecture/#3-shader-contracts" },"6": { "doc": "Architecture", "title": "4. Control Inputs", "content": "OSC, keyboard, transport, and external state. Control is external to rendering. It modifies node parameters without altering graph structure. Examples: . | OSC messages | Transport controls | Keyboard events | External automation | . Control never executes shaders directly. It updates parameters. The runtime then applies those changes on the next frame. This separation prevents race conditions and keeps execution deterministic. ", "url": "/architecture/#4-control-inputs", "relUrl": "/architecture/#4-control-inputs" },"7": { "doc": "Architecture", "title": "5. Output Targets", "content": "Render targets and external integrations. Outputs define where frames go. They consume the final graph results and route them to: . | Windows | Textures | Syphon / Spout | Encoders (future) | Network streams (future) | . Outputs do not modify graph state. They are sinks. ", "url": "/architecture/#5-output-targets", "relUrl": "/architecture/#5-output-targets" },"8": { "doc": "Architecture", "title": "Layer Isolation Philosophy", "content": "Each layer is intentionally isolated to enforce: . | Predictable execution | Clear debugging boundaries | Modular crate evolution | Real-time performance discipline | Long-term SDK stability | . No layer implicitly reaches into another. All interaction is explicit. ", "url": "/architecture/#layer-isolation-philosophy", "relUrl": "/architecture/#layer-isolation-philosophy" },"9": { "doc": "Core Concepts", "title": "Core Concepts", "content": "Graph A declarative structure defining signal flow between nodes. Node A unit of execution implementing a defined contract. Nodes consume and produce textures. Instrument An executable built on the scheng SDK that wires graph, runtime, and controls. Runtime The system responsible for frame scheduling and dispatch. Transport Time and playback control propagation through the graph. Control Surface External systems that modify node parameters in real time. ", "url": "/core-concepts/", "relUrl": "/core-concepts/" },"10": { "doc": "Crate Map", "title": "Crate Map", "content": "This document defines the architectural boundaries of the scheng / Schengine workspace. It describes where responsibilities live and, equally important, where they do not. This is not an API reference. It is a system ownership map. The workspace is organized around strict separation of concerns: . | Topology (graph) | Configuration (NodeProps) | Execution (runtime) | GPU integration (runtime-glow) | Input/Output integration (edge crates) | . No crate should violate these boundaries. ", "url": "/sdk/crate-map/", "relUrl": "/sdk/crate-map/" },"11": { "doc": "Crate Map", "title": "Core Crates", "content": "scheng-core . Purpose: Defines foundational types and traits shared across the engine. Responsibilities: . | Shared identifiers (NodeId, etc.) | Core trait definitions | Minimal dependency surface | . Non-Responsibilities: . | No GL bindings | No windowing | No device access | No execution logic | . This crate must remain small and dependency-light. scheng-graph . Purpose: Defines graph topology and compilation. Responsibilities: . | Node instantiation | Port definitions | Connection wiring | Validation | Compilation into execution plans | . Non-Responsibilities: . | No shader compilation | No GPU resources | No runtime execution | No parameter mutation | . Graph is static topology only. scheng-runtime . Purpose: Defines abstract execution traits. Responsibilities: . | Execution interfaces | Plan execution contracts | Runtime behavior definitions (abstract) | . Non-Responsibilities: . | No concrete GL integration | No device management | . This crate defines what it means to execute a plan, without specifying how. scheng-runtime-glow . Purpose: Concrete OpenGL runtime implementation using glow. Responsibilities: . | Shader compilation | Program caching | Texture management | Framebuffer allocation | Per-frame execution | . Non-Responsibilities: . | No topology mutation | No control protocol parsing | No time ownership | . This crate is the GPU execution engine. ", "url": "/sdk/crate-map/#core-crates", "relUrl": "/sdk/crate-map/#core-crates" },"12": { "doc": "Crate Map", "title": "Input / Output Crates", "content": "scheng-input-video . Purpose: Video decoding and texture production. Responsibilities: . | External decode integration | JSON configuration loading | Texture delivery to graph | . Non-Responsibilities: . | No transport control | No engine time management | . ", "url": "/sdk/crate-map/#input--output-crates", "relUrl": "/sdk/crate-map/#input--output-crates" },"13": { "doc": "Crate Map", "title": "Integration Boundary", "content": "Platform-specific integrations (Syphon, Spout, capture, etc.) must: . | Live outside core crates | Treat runtime as a pure execution engine | Avoid injecting platform logic into engine internals | . ", "url": "/sdk/crate-map/#integration-boundary", "relUrl": "/sdk/crate-map/#integration-boundary" },"14": { "doc": "Crate Map", "title": "Stability Expectations", "content": "This crate map is a contract between contributors. Core crates should change slowly. Runtime implementations may evolve, but must not break: . | Graph compilation guarantees | NodeProps contract | FrameCtx semantics | . ", "url": "/sdk/crate-map/#stability-expectations", "relUrl": "/sdk/crate-map/#stability-expectations" },"15": { "doc": "Frame Context (`FrameCtx`)", "title": "Frame Context (FrameCtx)", "content": "FrameCtx defines the complete, immutable execution context for a single frame of graph execution. It is the only global, per-frame input provided to the runtime. ", "url": "/sdk/frame-ctx/#frame-context-framectx", "relUrl": "/sdk/frame-ctx/#frame-context-framectx" },"16": { "doc": "Frame Context (`FrameCtx`)", "title": "Role in the System", "content": "FrameCtx establishes: . | Render dimensions | Temporal position | Frame identity | . The runtime does not maintain internal time, frame counters, or implicit scheduling. All temporal semantics originate from FrameCtx. ", "url": "/sdk/frame-ctx/#role-in-the-system", "relUrl": "/sdk/frame-ctx/#role-in-the-system" },"17": { "doc": "Frame Context (`FrameCtx`)", "title": "Data Structure", "content": "pub struct FrameCtx { pub width: u32, pub height: u32, pub time: f32, pub frame: u64, } . ", "url": "/sdk/frame-ctx/#data-structure", "relUrl": "/sdk/frame-ctx/#data-structure" },"18": { "doc": "Frame Context (`FrameCtx`)", "title": "Field Semantics", "content": "width / height . Defines the target render resolution for the frame. Effects: . | Sets viewport dimensions | Propagates to shader uniform uResolution | Determines render target allocation size | . Changing resolution between frames is allowed but may cause internal resource reallocation. time . Floating-point time value in seconds. The runtime: . | Forwards this value to shaders (uTime) | Does not interpret or constrain it | Does not enforce monotonicity | . Valid patterns: . | Monotonic wall-clock progression | Manual scrubbing | Looping time domains | Discontinuous jumps | . frame . Unsigned frame index. The runtime: . | Forwards this value to shaders (uFrame) | Does not enforce increment rules | Does not derive timing from it | . Used for deterministic frame identity and debugging. ", "url": "/sdk/frame-ctx/#field-semantics", "relUrl": "/sdk/frame-ctx/#field-semantics" },"19": { "doc": "Frame Context (`FrameCtx`)", "title": "Guarantees", "content": ". | Immutable during execution | Stable for the duration of a frame | No hidden time accumulation in the runtime | No implicit scheduler dependency | . ", "url": "/sdk/frame-ctx/#guarantees", "relUrl": "/sdk/frame-ctx/#guarantees" },"20": { "doc": "Frame Context (`FrameCtx`)", "title": "Failure Modes", "content": "Improper usage may result in: . | Shader logic misbehavior (if time assumptions are violated) | Resource churn (if resolution fluctuates excessively) | Non-deterministic results (if frame/time values are inconsistent) | . ", "url": "/sdk/frame-ctx/#failure-modes", "relUrl": "/sdk/frame-ctx/#failure-modes" },"21": { "doc": "Frame Context (`FrameCtx`)", "title": "Design Rationale", "content": "Separating frame context from runtime state ensures: . | Deterministic execution | Replayability | Offline rendering capability | Explicit time control | . The engine never owns time. ", "url": "/sdk/frame-ctx/#design-rationale", "relUrl": "/sdk/frame-ctx/#design-rationale" },"22": { "doc": "Frame Context (`FrameCtx`)", "title": "Frame Context (`FrameCtx`)", "content": " ", "url": "/sdk/frame-ctx/", "relUrl": "/sdk/frame-ctx/" },"23": { "doc": "Getting Started", "title": "Getting Started", "content": " ", "url": "/getting-started/", "relUrl": "/getting-started/" },"24": { "doc": "Getting Started", "title": "Install dependencies", "content": "bundle install . ", "url": "/getting-started/#install-dependencies", "relUrl": "/getting-started/#install-dependencies" },"25": { "doc": "Getting Started", "title": "Run locally", "content": "bundle exec jekyll serve . Open http://127.0.0.1:4000 in your browser. ", "url": "/getting-started/#run-locally", "relUrl": "/getting-started/#run-locally" },"26": { "doc": "Glossary", "title": "Glossary", "content": "This glossary defines the canonical terminology used throughout the ShadeCore SDK documentation. The definitions here are authoritative. If a term is used in SDK, Internals, or Patterns documentation, it should align with this glossary. ", "url": "/glossary/", "relUrl": "/glossary/" },"27": { "doc": "Glossary", "title": "Core Architectural Terms", "content": " ", "url": "/glossary/#core-architectural-terms", "relUrl": "/glossary/#core-architectural-terms" },"28": { "doc": "Glossary", "title": "Instrument", "content": "A user-defined application built on top of the ShadeCore engine. An instrument is responsible for: . | Constructing the Graph | Supplying NodeProps | Supplying FrameCtx | Handling control input (OSC, MIDI, etc.) | Managing external textures or devices | . The engine does not define instruments. Instruments define themselves around the engine. ", "url": "/glossary/#instrument", "relUrl": "/glossary/#instrument" },"29": { "doc": "Glossary", "title": "Engine", "content": "The collective core crates that define: . | Graph topology | Runtime execution | GPU integration | . The engine is deterministic and execution-focused. It does not own time, control protocols, or device management. ", "url": "/glossary/#engine", "relUrl": "/glossary/#engine" },"30": { "doc": "Glossary", "title": "Graph", "content": "The static topology describing how nodes connect. The graph defines: . | Nodes | Ports | Directed connections | Acyclic data flow | . The graph does not define behavior. It defines structure. ", "url": "/glossary/#graph", "relUrl": "/glossary/#graph" },"31": { "doc": "Glossary", "title": "Execution Plan", "content": "An immutable, compiled representation of a Graph. Produced by calling compile(). The execution plan defines: . | Deterministic node order | Validated connections | Runtime-ready topology | . The plan cannot be modified once compiled. ", "url": "/glossary/#execution-plan", "relUrl": "/glossary/#execution-plan" },"32": { "doc": "Glossary", "title": "Node", "content": "A single unit of computation inside the graph. A node may: . | Produce textures | Transform textures | Combine textures | Write final outputs | . Nodes do not own time or control state. ", "url": "/glossary/#node", "relUrl": "/glossary/#node" },"33": { "doc": "Glossary", "title": "NodeId", "content": "An opaque identifier assigned by the Graph. Used as the key into: . | NodeProps | Shader bindings | Parameter maps | . NodeId is stable for the lifetime of a graph instance. ", "url": "/glossary/#nodeid", "relUrl": "/glossary/#nodeid" },"34": { "doc": "Glossary", "title": "NodeProps", "content": "The complete configuration surface for nodes. NodeProps supplies: . | Shader sources | Mixer parameters | Video configuration | Texture bindings | Output naming | . NodeProps is owned by the instrument and read by the runtime. ", "url": "/glossary/#nodeprops", "relUrl": "/glossary/#nodeprops" },"35": { "doc": "Glossary", "title": "FrameCtx", "content": "The immutable per-frame execution context. Contains: . | width | height | time | frame | . The engine does not generate or mutate FrameCtx. ", "url": "/glossary/#framectx", "relUrl": "/glossary/#framectx" },"36": { "doc": "Glossary", "title": "Runtime", "content": "The component that executes a compiled plan for one frame. The runtime: . | Reads NodeProps | Reads FrameCtx | Binds resources | Dispatches draw calls | Produces outputs | . The runtime is not a scheduler. ", "url": "/glossary/#runtime", "relUrl": "/glossary/#runtime" },"37": { "doc": "Glossary", "title": "Runtime Implementation", "content": "A concrete execution backend. Example: . | shadecore-runtime-glow | . Responsible for: . | Shader compilation | GL resource management | Texture allocation | Framebuffer management | . ", "url": "/glossary/#runtime-implementation", "relUrl": "/glossary/#runtime-implementation" },"38": { "doc": "Glossary", "title": "GPU &amp; Rendering Terms", "content": " ", "url": "/glossary/#gpu--rendering-terms", "relUrl": "/glossary/#gpu--rendering-terms" },"39": { "doc": "Glossary", "title": "ShaderPass", "content": "A processing node that executes a GLSL program over input textures. Used for: . | Effects | Transformations | Post-processing | . ", "url": "/glossary/#shaderpass", "relUrl": "/glossary/#shaderpass" },"40": { "doc": "Glossary", "title": "Mixer", "content": "A node that combines multiple input textures into one output. Mixing semantics are defined entirely by the shader. The engine does not impose RGB or channel semantics. ", "url": "/glossary/#mixer", "relUrl": "/glossary/#mixer" },"41": { "doc": "Glossary", "title": "Uniform", "content": "A shader parameter supplied by the runtime. Standard uniforms include: . | uResolution | uTime | uFrame | . Custom uniforms must be supplied via NodeProps. ", "url": "/glossary/#uniform", "relUrl": "/glossary/#uniform" },"42": { "doc": "Glossary", "title": "Sampler Binding", "content": "The mapping between a graph input texture and a shader sampler uniform. Sampler ordering is deterministic per node kind. ", "url": "/glossary/#sampler-binding", "relUrl": "/glossary/#sampler-binding" },"43": { "doc": "Glossary", "title": "Framebuffer (FBO)", "content": "A GPU render target used for intermediate or final outputs. Managed internally by the runtime implementation. ", "url": "/glossary/#framebuffer-fbo", "relUrl": "/glossary/#framebuffer-fbo" },"44": { "doc": "Glossary", "title": "Control &amp; Integration Terms", "content": " ", "url": "/glossary/#control--integration-terms", "relUrl": "/glossary/#control--integration-terms" },"45": { "doc": "Glossary", "title": "Control Layer", "content": "The instrument-level system that: . | Receives external messages (OSC, MIDI, etc.) | Maps values to parameters | Updates NodeProps | . The control layer is outside the engine. ", "url": "/glossary/#control-layer", "relUrl": "/glossary/#control-layer" },"46": { "doc": "Glossary", "title": "OSC Contract", "content": "The pattern by which OSC values are translated into parameter updates. The engine does not parse OSC directly. ", "url": "/glossary/#osc-contract", "relUrl": "/glossary/#osc-contract" },"47": { "doc": "Glossary", "title": "Texture Input", "content": "An externally created texture injected into the graph. Ownership model: . | Instrument owns the texture handle | Runtime consumes it during execution | . ", "url": "/glossary/#texture-input", "relUrl": "/glossary/#texture-input" },"48": { "doc": "Glossary", "title": "Transport", "content": "The time-control model implemented by the instrument. Examples: . | Play | Pause | Scrub | Loop | . Transport logic updates FrameCtx.time. ", "url": "/glossary/#transport", "relUrl": "/glossary/#transport" },"49": { "doc": "Glossary", "title": "Determinism &amp; Execution Terms", "content": " ", "url": "/glossary/#determinism--execution-terms", "relUrl": "/glossary/#determinism--execution-terms" },"50": { "doc": "Glossary", "title": "Deterministic Execution", "content": "For identical: . | Graph | NodeProps | FrameCtx | . The runtime produces identical execution order and resource bindings. Shader determinism depends on shader code. ", "url": "/glossary/#deterministic-execution", "relUrl": "/glossary/#deterministic-execution" },"51": { "doc": "Glossary", "title": "Lazy Compilation", "content": "Shader programs are compiled only on first use. Compiled programs are cached for reuse across frames. ", "url": "/glossary/#lazy-compilation", "relUrl": "/glossary/#lazy-compilation" },"52": { "doc": "Glossary", "title": "Hot Path", "content": "The per-frame execution path. Must avoid: . | Allocation | Shader recompilation | Blocking I/O | . ", "url": "/glossary/#hot-path", "relUrl": "/glossary/#hot-path" },"53": { "doc": "Glossary", "title": "Architectural Boundaries", "content": " ", "url": "/glossary/#architectural-boundaries", "relUrl": "/glossary/#architectural-boundaries" },"54": { "doc": "Glossary", "title": "Topology vs Configuration", "content": "Topology: . | Defined by Graph | Static after compile | . Configuration: . | Defined by NodeProps | Mutable between frames | . ", "url": "/glossary/#topology-vs-configuration", "relUrl": "/glossary/#topology-vs-configuration" },"55": { "doc": "Glossary", "title": "Engine vs Instrument", "content": "Engine: . | Deterministic executor | No protocol ownership | No device ownership | No time ownership | . Instrument: . | Owns time | Owns control | Owns external textures | Owns graph construction | . ", "url": "/glossary/#engine-vs-instrument", "relUrl": "/glossary/#engine-vs-instrument" },"56": { "doc": "Glossary", "title": "Non-Goals", "content": "The engine is not: . | A media player | A scheduler | A device manager | A protocol parser | . These responsibilities belong to the instrument layer. ", "url": "/glossary/#non-goals", "relUrl": "/glossary/#non-goals" },"57": { "doc": "Graph API", "title": "Graph API", "content": "The Graph API defines execution topology. It specifies how nodes connect and how structure is validated. It does not define node behavior or perform execution. This functionality lives in scheng-graph. ", "url": "/sdk/graph-api/", "relUrl": "/sdk/graph-api/" },"58": { "doc": "Graph API", "title": "Topology", "content": "A graph is a directed set of nodes connected by typed ports. Each node exposes: . | Input ports | Output ports | . Connections define data flow between nodes. Example: . Input → ColorCorrect → Blur → Output . The Graph API defines and validates this structure before runtime execution begins. ", "url": "/sdk/graph-api/#topology", "relUrl": "/sdk/graph-api/#topology" },"59": { "doc": "Graph API", "title": "Responsibilities", "content": "The graph: . | Creates node instances | Defines port layouts | Connects output ports to input ports | Validates topology | Compiles into an immutable execution plan | . Once compiled, topology is fixed until recompilation. ", "url": "/sdk/graph-api/#responsibilities", "relUrl": "/sdk/graph-api/#responsibilities" },"60": { "doc": "Graph API", "title": "Compilation", "content": "Calling compile() performs: . | Cycle detection | Port validation | Deterministic topological sorting | Execution plan construction | . The resulting plan is immutable and safe for repeated per-frame evaluation. ", "url": "/sdk/graph-api/#compilation", "relUrl": "/sdk/graph-api/#compilation" },"61": { "doc": "Graph API", "title": "Separation of Concerns", "content": "The Graph API does NOT define: . | Shader code | Parameter values | Execution timing | Control input | GPU resource management | . Behavior is provided via NodeProps and FrameCtx. Execution is handled by scheng-runtime. GPU fulfillment is handled by scheng-runtime-glow. ", "url": "/sdk/graph-api/#separation-of-concerns", "relUrl": "/sdk/graph-api/#separation-of-concerns" },"62": { "doc": "Graph API", "title": "Determinism", "content": "Given identical: . | Graph topology | NodeProps | FrameCtx | . Execution order is deterministic (assuming deterministic shaders). Topology determinism is guaranteed at compile time. ", "url": "/sdk/graph-api/#determinism", "relUrl": "/sdk/graph-api/#determinism" },"63": { "doc": "Graph API", "title": "Design Rule", "content": "Topology is static. Configuration is dynamic. Structure must be compiled before execution. ", "url": "/sdk/graph-api/#design-rule", "relUrl": "/sdk/graph-api/#design-rule" },"64": { "doc": "SDK", "title": "SDK Reference", "content": "API surface, contracts, and node-level details for the ShadeCore SDK. ", "url": "/sdk/#sdk-reference", "relUrl": "/sdk/#sdk-reference" },"65": { "doc": "SDK", "title": "SDK", "content": " ", "url": "/sdk/", "relUrl": "/sdk/" },"66": { "doc": "Examples", "title": "Examples", "content": " ", "url": "/examples/", "relUrl": "/examples/" },"67": { "doc": "Home", "title": "Home", "content": ". scheng is a Rust-based engine for GPU-accelerated video synthesis and real-time video instrument development. It provides a graph-based execution model, explicit shader and node contracts, and a modular SDK surface for building deterministic, extensible visual systems. ", "url": "/", "relUrl": "/" },"68": { "doc": "Known Constraints and Non-Goals", "title": "Known Constraints and Non-Goals", "content": "This document records intentional architectural constraints. These define what the engine does not do and where responsibility boundaries exist. ", "url": "/sdk/known-constraints/", "relUrl": "/sdk/known-constraints/" },"69": { "doc": "Known Constraints and Non-Goals", "title": "Time and Transport", "content": "This section defines how temporal control is handled in the system. The engine evaluates frames. It does not manage playback state or time progression. Constraint: The engine does not own time. Implications: . | No play/pause inside core crates | No internal frame clock | No transport logic in runtime | . All transport semantics belong to the instrument layer. *Subject to change . ", "url": "/sdk/known-constraints/#time-and-transport", "relUrl": "/sdk/known-constraints/#time-and-transport" },"70": { "doc": "Known Constraints and Non-Goals", "title": "Control Protocols", "content": "This section defines how external control signals enter the system. The engine processes values. It does not implement protocol handling. Constraint: The engine is protocol-agnostic. Implications: . | No OSC parsing in core crates | No MIDI handling in runtime | No network socket management | . Control values enter the engine via NodeProps only. ", "url": "/sdk/known-constraints/#control-protocols", "relUrl": "/sdk/known-constraints/#control-protocols" },"71": { "doc": "Known Constraints and Non-Goals", "title": "Device Management", "content": "This section defines the boundary between the engine and hardware. The engine consumes GPU resources but does not manage devices. Constraint: Device interaction is external. Implications: . | No webcam enumeration in runtime | No OS-specific capture APIs in engine | No platform-specific code in core crates | . The engine consumes textures. It does not manage hardware. ", "url": "/sdk/known-constraints/#device-management", "relUrl": "/sdk/known-constraints/#device-management" },"72": { "doc": "Known Constraints and Non-Goals", "title": "Node Surface Area", "content": "This section defines how node types evolve. The system favors extensibility through configuration rather than proliferation of node categories. Constraint: Node kinds must remain minimal. Implications: . | Prefer shader extensibility over introducing new node types | Avoid duplicating node categories | Preserve stable execution semantics | . New behavior should default to shader or instrument-level extension. ", "url": "/sdk/known-constraints/#node-surface-area", "relUrl": "/sdk/known-constraints/#node-surface-area" },"73": { "doc": "Known Constraints and Non-Goals", "title": "Performance Constraints", "content": "This section defines execution-level performance expectations. The runtime must remain predictable and allocation-stable under per-frame load. Performance issues should be addressed at the instrument level before modifying engine internals. The engine avoids: . | Per-frame allocation in hot paths | Shader recompilation per frame | Hidden resource churn | . ", "url": "/sdk/known-constraints/#performance-constraints", "relUrl": "/sdk/known-constraints/#performance-constraints" },"74": { "doc": "Known Constraints and Non-Goals", "title": "Contributor Guidance", "content": "This section clarifies ownership boundaries when proposing changes. If ownership is unclear, default to instrument-level implementation. When proposing changes, determine ownership: . | Topology (scheng-graph) | Configuration (NodeProps) | Runtime (scheng-runtime) | Instrument layer | . ", "url": "/sdk/known-constraints/#contributor-guidance", "relUrl": "/sdk/known-constraints/#contributor-guidance" },"75": { "doc": "Known Constraints and Non-Goals", "title": "Core Principle", "content": "This section summarizes the architectural intent. Behavior belongs at the edges. The engine remains: . | Small | Deterministic | Execution-focused | . ", "url": "/sdk/known-constraints/#core-principle", "relUrl": "/sdk/known-constraints/#core-principle" },"76": { "doc": "Node Kinds", "title": "Node Kinds", "content": "Node kinds define execution roles within a compiled graph. They classify how a node participates in topology and evaluation. Behavior is still determined by shader code and NodeProps. | Node kinds do not alter execution order. | Ordering is determined by graph topology. | . ", "url": "/sdk/node-kinds/", "relUrl": "/sdk/node-kinds/" },"77": { "doc": "Node Kinds", "title": "Source Nodes", "content": "Source nodes produce textures without upstream dependencies.They have no required input ports. Examples: . | Video decode nodes | Capture inputs | Procedural generators | . Characteristics: . | At least one output port | No required input connections | Output produced once per frame (unless upstream resource failure) | . ", "url": "/sdk/node-kinds/#source-nodes", "relUrl": "/sdk/node-kinds/#source-nodes" },"78": { "doc": "Node Kinds", "title": "Processing Nodes", "content": "Processing nodes transform one or more input textures into a new output texture. Examples: . | Shader passes | Color transforms | Post-processing stages | . Characteristics: . | Require input connections | Produce at least one output | Deterministic given identical inputs, NodeProps, and shaders | . ", "url": "/sdk/node-kinds/#processing-nodes", "relUrl": "/sdk/node-kinds/#processing-nodes" },"79": { "doc": "Node Kinds", "title": "Mixer Nodes", "content": "Mixer nodes combine multiple input textures into a single output. Characteristics: . | Fixed input count per node type | Combination semantics defined by shader | Parameters supplied via NodeProps | Deterministic given identical inputs and configuration | . ", "url": "/sdk/node-kinds/#mixer-nodes", "relUrl": "/sdk/node-kinds/#mixer-nodes" },"80": { "doc": "Node Kinds", "title": "Output Nodes", "content": "Output nodes terminate the graph. They write results to: . | Framebuffers | Named outputs | Readback buffers | . Characteristics: . | May consume inputs | Do not produce downstream outputs | Represent terminal graph boundaries | . ", "url": "/sdk/node-kinds/#output-nodes", "relUrl": "/sdk/node-kinds/#output-nodes" },"81": { "doc": "Node Kinds", "title": "Design Constraints", "content": "Node kinds describe structural roles only. These responsibilities belong to scheng-graph, scheng-runtime, and backend implementations. They do not: . | Control execution timing | Modify topology during evaluation | Manage GPU resources | Introduce scheduling behavior | . ", "url": "/sdk/node-kinds/#design-constraints", "relUrl": "/sdk/node-kinds/#design-constraints" },"82": { "doc": "Node Kinds", "title": "Extensibility Guidance", "content": "Avoid introducing new node kinds unless execution semantics require a distinct structural role. Prefer extending behavior through: . | New shaders | Additional NodeProps configuration | . ", "url": "/sdk/node-kinds/#extensibility-guidance", "relUrl": "/sdk/node-kinds/#extensibility-guidance" },"83": { "doc": "NodeProps Reference", "title": "NodeProps Reference", "content": "NodeProps defines the complete dynamic configuration surface for nodes &amp; supplies per-node configuration used during evaluation. Topology is defined by scheng-graph. Execution is performed by scheng-runtime. All dynamic behavior flows through this structure. ", "url": "/sdk/node-props/", "relUrl": "/sdk/node-props/" },"84": { "doc": "NodeProps Reference", "title": "Ownership Model", "content": "NodeProps is: . | Owned and managed by the caller | Read-only during execution | Never mutated by the runtime | . The runtime consumes configuration. It does not store behavioral state internally. This separation ensures deterministic frame evaluation. ", "url": "/sdk/node-props/#ownership-model", "relUrl": "/sdk/node-props/#ownership-model" },"85": { "doc": "NodeProps Reference", "title": "Responsibilities", "content": "NodeProps supplies per-node configuration, including: . | Shader sources | Uniform and parameter values | Mixer weights | Video decode configuration | External texture bindings | Output naming | . NodeProps does not define topology. It configures nodes within an already compiled graph. ", "url": "/sdk/node-props/#responsibilities", "relUrl": "/sdk/node-props/#responsibilities" },"86": { "doc": "NodeProps Reference", "title": "Runtime Interaction", "content": "During per-frame execution: . | The runtime reads configuration by NodeId | Binds shader programs | Sets uniforms and bindings | Executes draw calls | . Node behavior is derived entirely from: . | Graph topology | NodeProps | FrameCtx | . No hidden state persists inside nodes across frames. ", "url": "/sdk/node-props/#runtime-interaction", "relUrl": "/sdk/node-props/#runtime-interaction" },"87": { "doc": "NodeProps Reference", "title": "Update Semantics", "content": "Changes to NodeProps: . | Take effect on the next frame | Do not invalidate compiled topology | May trigger shader recompilation if shader sources change | . Structural changes require graph recompilation. ", "url": "/sdk/node-props/#update-semantics", "relUrl": "/sdk/node-props/#update-semantics" },"88": { "doc": "NodeProps Reference", "title": "Failure Modes", "content": "Incorrect configuration may result in: . | Shader compilation or link errors | Missing required input bindings | Invalid uniform values | . Errors are surfaced to the caller. The runtime does not attempt silent recovery. ", "url": "/sdk/node-props/#failure-modes", "relUrl": "/sdk/node-props/#failure-modes" },"89": { "doc": "OSC Contract", "title": "OSC Contract", "content": "The OSC Contract defines how external control values enter the instrument layer. The engine and runtime remain protocol-agnostic. Control systems update NodeProps. The runtime consumes those values during frame evaluation. ", "url": "/sdk/osc-contract/", "relUrl": "/sdk/osc-contract/" },"90": { "doc": "OSC Contract", "title": "Control Flow", "content": "Control integration occurs entirely outside core crates. Typical flow: . | Receive OSC message externally | Parse address and value | Map address to a NodeId and parameter | Update NodeProps | . The runtime reads updated values on the next frame. ", "url": "/sdk/osc-contract/#control-flow", "relUrl": "/sdk/osc-contract/#control-flow" },"91": { "doc": "OSC Contract", "title": "Guarantees", "content": ". | No protocol handling inside core engine crates | No transport dependency in scheng-runtime | Latest value wins | No implicit interpolation | No internal buffering beyond the current NodeProps state | . All temporal behavior must be implemented at the instrument layer. ", "url": "/sdk/osc-contract/#guarantees", "relUrl": "/sdk/osc-contract/#guarantees" },"92": { "doc": "OSC Contract", "title": "Responsibility Boundary", "content": "Application layer responsibilities: . | Socket lifecycle | Message parsing | Address validation | Value mapping | Range clamping | Thread synchronization | . Engine responsibilities: . | Read NodeProps | Apply values during deterministic frame evaluation | . The engine does not: . | Parse OSC | Maintain transport state | Perform smoothing or interpolation | . ", "url": "/sdk/osc-contract/#responsibility-boundary", "relUrl": "/sdk/osc-contract/#responsibility-boundary" },"93": { "doc": "OSC Contract", "title": "Recommended Practices", "content": ". | Clamp values before writing to NodeProps | Validate NodeId and parameter existence | Avoid blocking in control handlers | Synchronize updates if control input is multi-threaded | Log parameter updates when debugging | . Control systems should remain stateless beyond NodeProps. ", "url": "/sdk/osc-contract/#recommended-practices", "relUrl": "/sdk/osc-contract/#recommended-practices" },"94": { "doc": "Per Frame Execution Lifecycle", "title": "Per Frame Execution Lifecycle", "content": "This document defines the per-frame execution lifecycle. It describes how a compiled execution plan is evaluated. It does not define scheduling, timing, or graph mutation. ", "url": "/sdk/per-frame-execution-lifecycle/", "relUrl": "/sdk/per-frame-execution-lifecycle/" },"95": { "doc": "Per Frame Execution Lifecycle", "title": "Frame Boundary", "content": "Each invocation of: . execute_plan_outputs(...) . represents exactly one frame. The runtime does not: . | Schedule frames | Manage vsync | Accumulate time | . All temporal state is supplied externally via FrameCtx. ", "url": "/sdk/per-frame-execution-lifecycle/#frame-boundary", "relUrl": "/sdk/per-frame-execution-lifecycle/#frame-boundary" },"96": { "doc": "Per Frame Execution Lifecycle", "title": "Execution Steps", "content": "Given a compiled plan, evaluation proceeds in deterministic order: . | Read FrameCtx | Read NodeProps | Iterate nodes in topological order | For each node: . | Resolve input textures | Bind shader program | Set uniforms | Issue draw call | . | Write final outputs | . The execution plan is immutable. No topology changes occur during evaluation. ", "url": "/sdk/per-frame-execution-lifecycle/#execution-steps", "relUrl": "/sdk/per-frame-execution-lifecycle/#execution-steps" },"97": { "doc": "Per Frame Execution Lifecycle", "title": "Determinism", "content": "For identical: . | Graph topology | NodeProps state | FrameCtx values | . Execution order and resource usage are deterministic (assuming deterministic shaders). Structural determinism is guaranteed by scheng-graph. Execution determinism is enforced by scheng-runtime. ", "url": "/sdk/per-frame-execution-lifecycle/#determinism", "relUrl": "/sdk/per-frame-execution-lifecycle/#determinism" },"98": { "doc": "Per Frame Execution Lifecycle", "title": "Resource Lifecycle", "content": "GPU resources are managed lazily and cached: . | Shaders compile on first use | Programs are cached per node | Textures and FBOs are allocated on demand | Resources are reused across frames | . Reallocation occurs only if: . | Resolution changes | Shader source changes | Node configuration invalidates cache | . The runtime does not pre-allocate unused resources. ", "url": "/sdk/per-frame-execution-lifecycle/#resource-lifecycle", "relUrl": "/sdk/per-frame-execution-lifecycle/#resource-lifecycle" },"99": { "doc": "Per Frame Execution Lifecycle", "title": "Error Handling", "content": "Errors are returned to the caller immediately. Common failure cases: . | Shader compilation or link failure | Missing required configuration | GL context absence | Invalid bindings | . The runtime does not attempt silent recovery. ", "url": "/sdk/per-frame-execution-lifecycle/#error-handling", "relUrl": "/sdk/per-frame-execution-lifecycle/#error-handling" },"100": { "doc": "Per Frame Execution Lifecycle", "title": "Threading Model", "content": ". | Execution must occur on a thread with a current GL context. | The runtime is internally single-threaded. | External synchronization is the caller’s responsibility. | . Violating these assumptions results in undefined behavior. ", "url": "/sdk/per-frame-execution-lifecycle/#threading-model", "relUrl": "/sdk/per-frame-execution-lifecycle/#threading-model" },"101": { "doc": "Per Frame Execution Lifecycle", "title": "Design Scope", "content": "The runtime is a deterministic execution engine. It is not: . | A scheduler | A transport controller | A device manager | A time source | . ", "url": "/sdk/per-frame-execution-lifecycle/#design-scope", "relUrl": "/sdk/per-frame-execution-lifecycle/#design-scope" },"102": { "doc": "Pipeline", "title": "Pipeline", "content": "The pipeline describes how responsibility flows from instrument declaration to GPU fulfillment. This is not a call stack and not an internal implementation trace. It is a layered responsibility model aligned with crate boundaries. Each layer corresponds directly to architectural boundaries in the workspace. ", "url": "/sdk/pipeline", "relUrl": "/sdk/pipeline" },"103": { "doc": "Pipeline", "title": "Overview", "content": ". | Instrument Code → Instrument code describes structure, parameters, and execution intent. | SDK Contract Layer → The SDK formalizes those declarations into validated contracts. | Deterministic Runtime Evaluation → The runtime evaluates those contracts deterministically. | Backend GPU Execution → The backend executes the resulting shader work on the GPU. | . Key Principle . No layer reaches backward across boundaries. The pipeline enforces strict separation: . | Graph defines topology. | Runtime defines execution semantics. | Backend defines GPU fulfillment. | . This alignment ensures: . | Deterministic behavior | Backend independence | Clear ownership across crates | Stable extension points | . ", "url": "/sdk/pipeline#overview", "relUrl": "/sdk/pipeline#overview" },"104": { "doc": "Pipeline", "title": "Pipeline Layers", "content": "Instrument Code . This is user space. This layer declares structure only. Instrument code uses: . | scheng-graph to declare topology | NodeProps to configure parameter surfaces | Shader contracts to describe GPU expectations | . At this stage: . | No GPU resources exist | No frame execution occurs | No scheduling decisions are made | . SDK Contract Layer . No execution happens here. Only structural correctness is enforced. This corresponds to: . | scheng-graph validation | Contract enforcement in core types | . Responsibilities: . | Validate graph topology | Enforce typed port connections | Ensure NodeProps integrity | Guarantee structural determinism | . Deterministic Runtime Evaluation . This layer defines how plans are evaluated, but not how GPU work is performed. Runtime is abstract. This corresponds to: . | scheng-runtime | . Responsibilities: . | Accept compiled graph plans | Determine execution ordering | Maintain frame context | Invoke node execution contracts | . Backend GPU Execution . This layer fulfills the runtime contract using a concrete backend implementation. This corresponds to: . | scheng-runtime-glow | . Responsibilities: . | Compile shaders | Bind uniforms and textures | Allocate framebuffers | Dispatch GPU work | Produce output surfaces | . ", "url": "/sdk/pipeline#pipeline-layers", "relUrl": "/sdk/pipeline#pipeline-layers" },"105": { "doc": "Runtime Execution", "title": "Runtime Execution", "content": "The runtime evaluates a compiled execution plan for one frame. It implements execution semantics defined by the SDK. It does not schedule frames or manage time. This functionality is defined in scheng-runtime and fulfilled by backend implementations (e.g., scheng-runtime-glow). ", "url": "/sdk/runtime-execution/", "relUrl": "/sdk/runtime-execution/" },"106": { "doc": "Runtime Execution", "title": "Responsibilities", "content": "The runtime: . | Executes nodes in deterministic topological order | Resolves input dependencies | Binds GPU resources | Dispatches shader programs | Produces output textures | . The runtime does not mutate topology. ", "url": "/sdk/runtime-execution/#responsibilities", "relUrl": "/sdk/runtime-execution/#responsibilities" },"107": { "doc": "Runtime Execution", "title": "Execution Model", "content": "Each invocation: . | Accepts a FrameCtx | Reads current NodeProps | Evaluates the compiled execution plan | Returns resolved outputs | . No implicit time accumulation occurs. All temporal semantics are external. For detailed per-frame behavior, see Per-Frame Execution Lifecycle. ", "url": "/sdk/runtime-execution/#execution-model", "relUrl": "/sdk/runtime-execution/#execution-model" },"108": { "doc": "Runtime Execution", "title": "Resource Management", "content": "Resource management is implementation-defined by the backend. Typical behavior includes: . | Lazy shader compilation | Per-node program caching | Texture and framebuffer reuse across frames | . Resource lifetime follows the compiled plan and backend strategy. ", "url": "/sdk/runtime-execution/#resource-management", "relUrl": "/sdk/runtime-execution/#resource-management" },"109": { "doc": "Runtime Execution", "title": "Threading Model", "content": "Execution requires an active GL context on the calling thread. The runtime: . | Is internally single-threaded | Performs no implicit parallelism | . External synchronization is the caller’s responsibility. ", "url": "/sdk/runtime-execution/#threading-model", "relUrl": "/sdk/runtime-execution/#threading-model" },"110": { "doc": "Runtime Execution", "title": "Error Model", "content": "Execution may fail due to: . | Shader compilation or link errors | Missing required inputs | Invalid output configuration | Backend resource failures | . Errors are returned to the caller immediately. The runtime does not attempt silent recovery. ", "url": "/sdk/runtime-execution/#error-model", "relUrl": "/sdk/runtime-execution/#error-model" },"111": { "doc": "Overview", "title": "SDK Overview", "content": "The scheng SDK defines the public surface for building video instruments on top of the scheng engine. It provides the contracts, types, and execution interfaces required to construct graph-based, GPU-accelerated visual systems. This document describes the role, structure, and boundaries of the SDK. ", "url": "/sdk/#sdk-overview", "relUrl": "/sdk/#sdk-overview" },"112": { "doc": "Overview", "title": "High Level", "content": "At a high level, the SDK acts as the declarative contract layer between instrument code and engine fulfillment. The SDK defines … . | How nodes are declared | How parameters are structured | How frame context is passed | How shaders are registered and invoked | How execution is triggered per frame | . The SDK exists to … . | Define stable interfaces between graph, runtime, and shader layers | Enforce explicit execution contracts | Enable instrument development without modifying core engine internals | Provide predictable, deterministic runtime behavior | . The SDK does not include … . | Internal runtime scheduling details | GPU driver abstractions | Private engine state | Experimental or unstable internal utilities | . ", "url": "/sdk/#high-level", "relUrl": "/sdk/#high-level" },"113": { "doc": "Overview", "title": "Scope", "content": "Graph Construction APIs . The Graph Construction APIs provide the primitives for building directed execution graphs that define how data flows between nodes. These APIs allow developers to create nodes, connect outputs to inputs, define execution order, and describe the overall topology of a visual or computational pipeline. They form the structural backbone of the SDK — enabling deterministic, inspectable, and reusable graph definitions. Responsibilities: . | Node instantiation | Texture routing | Graph topology validation | . Node Contract Definitions . Node contracts define the formal interface of a node: its inputs, outputs, expected data types, and execution behavior. A contract ensures that nodes can be validated, composed, and executed safely within the graph without ambiguity. These definitions create strict boundaries between graph logic and runtime implementation, ensuring consistency across custom and built-in nodes. Responsibilities: . | Define input/output texture expectations | Expose configurable parameters | Execute per-frame logic safely | . Runtime Execution Interfaces . Defines how frames are planned and dispatched. Runtime execution interfaces provide the abstraction layer responsible for evaluating the graph. They define how nodes are scheduled, how frames or buffers are processed, and how outputs are resolved. The runtime does not define shader behavior. It coordinates execution. This layer separates graph definition from execution backend (e.g., CPU, GPU, Glow, headless runtime), allowing multiple runtimes to operate against the same graph model. Responsibilities: . | Accept graph definitions | Prepare execution plans | Invoke node execution in correct order | Maintain frame context | . Shader Form Contracts . Defines the interface between node logic and GPU shader forms. Shader form contracts describe the expected structure and binding behavior of shader-based nodes. They define how uniforms, textures, and parameters are exposed and mapped to the runtime. This ensures that shader modules behave predictably across runtimes and that parameter surfaces are formally declared rather than implicitly assumed. Responsibilities: . | Uniform bindings | Texture inputs | Output target definitions | Explicit parameter mapping | . NodeProps and Parameter Surfaces . NodeProps represent the configurable parameter surface of a node. Defines parameter surfaces for nodes. They provide a structured way to expose values such as floats, toggles, vectors, or other control inputs that influence node behavior. Parameter surfaces are designed to be introspectable and controllable, making them compatible with UI systems, automation, or external control signals. NodeProps are the boundary between control inputs and execution logic. Responsibilities: . | Store runtime-modifiable values | Provide default configuration | Maintain deterministic parameter state | . Control Propagation Structures (e.g., OSC Integration Points) . Control propagation structures define how external control signals move through the system. This includes integration points for OSC, MIDI, or other real-time control mechanisms. These structures ensure that parameter updates, automation, and live performance inputs can be injected into the graph safely and deterministically without breaking execution guarantees. ", "url": "/sdk/#scope", "relUrl": "/sdk/#scope" },"114": { "doc": "Overview", "title": "Overview", "content": " ", "url": "/sdk/", "relUrl": "/sdk/" },"115": { "doc": "Shader Contract", "title": "Shader Contract", "content": "The Shader Contract defines the interface between scheng-runtime and GLSL programs. Shaders provide visual behavior. The runtime provides execution context and resource binding. *Subject to change . ", "url": "/sdk/shader-contract/", "relUrl": "/sdk/shader-contract/" },"116": { "doc": "Shader Contract", "title": "Engine Guarantees", "content": "During execution, the runtime guarantees: . | A valid and current GL context | Bound input textures in deterministic order | Standard uniforms: . | uResolution | uTime | uFrame | . | Correct framebuffer binding for output | . Sampler ordering is stable and corresponds to graph port ordering. The runtime handles: . | Program compilation | Uniform binding | Texture binding | Draw dispatch | . ", "url": "/sdk/shader-contract/#engine-guarantees", "relUrl": "/sdk/shader-contract/#engine-guarantees" },"117": { "doc": "Shader Contract", "title": "Shader Responsibilities", "content": "Shaders must: . | Compile under the supported GLSL version | Declare required samplers and uniforms | Write a valid output color | Respect provided sampler bindings | . Shaders must not assume: . | Hidden engine state | Implicit uniforms | Dynamic topology changes | . Behavior must be fully determined by: . | Input textures | Provided uniforms | NodeProps configuration | . ", "url": "/sdk/shader-contract/#shader-responsibilities", "relUrl": "/sdk/shader-contract/#shader-responsibilities" },"118": { "doc": "Shader Contract", "title": "Custom Uniforms", "content": "Custom uniforms are supplied via NodeProps. The runtime reads values from NodeProps and sets them before dispatch. If a shader declares a uniform that is not provided via NodeProps, the result is undefined. Structural changes to uniforms require recompilation. ", "url": "/sdk/shader-contract/#custom-uniforms", "relUrl": "/sdk/shader-contract/#custom-uniforms" },"119": { "doc": "Shader Contract", "title": "Compilation Model", "content": "Shaders are: . | Compiled lazily on first use | Cached per node instance | Recompiled only when shader source changes | . Compilation failures are returned to the caller immediately. ", "url": "/sdk/shader-contract/#compilation-model", "relUrl": "/sdk/shader-contract/#compilation-model" },"120": { "doc": "Shader Contract", "title": "Execution Boundary", "content": "The runtime controls: . | Execution order | Resource lifetime | Frame boundaries | . Shaders control: . | Pixel-level visual behavior | . The engine does not interpret shader semantics. ", "url": "/sdk/shader-contract/#execution-boundary", "relUrl": "/sdk/shader-contract/#execution-boundary" } } </main> </div> </div> <div class="search-overlay"></div> </div> </body> </html>
