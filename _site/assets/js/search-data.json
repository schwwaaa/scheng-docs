ttp://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"> <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line> </svg> </symbol> <!-- Bootstrap Icons. MIT License: https://github.com/twbs/icons/blob/main/LICENSE.md --> <symbol id="svg-copy" viewBox="0 0 16 16"> <title>Copy</title> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard" viewBox="0 0 16 16"> <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1v-1z"/> <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3z"/> </svg> </symbol> <symbol id="svg-copied" viewBox="0 0 16 16"> <title>Copied</title> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clipboard-check-fill" viewBox="0 0 16 16"> <path d="M6.5 0A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3Zm3 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5h3Z"/> <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1A2.5 2.5 0 0 1 9.5 5h-3A2.5 2.5 0 0 1 4 2.5v-1Zm6.854 7.354-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L7.5 10.793l2.646-2.647a.5.5 0 0 1 .708.708Z"/> </svg> </symbol> </svg> <div class="side-bar"> <div class="site-header" role="banner"> <a href="/" class="site-title lh-tight"> scheng </a> <button id="menu-button" class="site-button btn-reset" aria-label="Toggle menu" aria-pressed="false"> <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><use xlink:href="#svg-menu"></use></svg> </button> </div> <nav aria-label="Main" id="site-nav" class="site-nav"> <ul class="nav-list"><li class="nav-list-item"><a href="/overview/" class="nav-list-link">Overview</a></li><li class="nav-list-item"><button class="nav-list-expander btn-reset" aria-label="toggle items in SDK Reference category" aria-pressed="false"> <svg viewBox="0 0 24 24" aria-hidden="true"><use xlink:href="#svg-arrow-right"></use></svg> </button><a href="/sdk/" class="nav-list-link">SDK Reference</a><ul class="nav-list"><li class="nav-list-item"><a href="/sdk/" class="nav-list-link">SDK Overview</a></li><li class="nav-list-item"><a href="/sdk/frame-ctx/" class="nav-list-link">Frame Context (`FrameCtx`)</a></li><li class="nav-list-item"><a href="/sdk/crate-map/" class="nav-list-link">Crate Map</a></li><li class="nav-list-item"><a href="/sdk/graph-api/" class="nav-list-link">Graph API</a></li><li class="nav-list-item"><a href="/sdk/execution-model/" class="nav-list-link">Execution Model Internals</a></li><li class="nav-list-item"><a href="/sdk/known-constraints/" class="nav-list-link">Known Constraints and Non-Goals</a></li><li class="nav-list-item"><a href="/sdk/node-kinds/" class="nav-list-link">Node Kinds</a></li><li class="nav-list-item"><a href="/sdk/node-props/" class="nav-list-link">NodeProps Reference</a></li><li class="nav-list-item"><a href="/sdk/osc-contract/" class="nav-list-link">OSC Contract</a></li><li class="nav-list-item"><a href="/sdk/runtime-execution/" class="nav-list-link">Runtime Execution</a></li><li class="nav-list-item"><a href="/sdk/shader-contract/" class="nav-list-link">Shader Contract</a></li></ul></li><li class="nav-list-item"><a href="/getting-started/" class="nav-list-link">Getting Started</a></li><li class="nav-list-item"><button class="nav-list-expander btn-reset" aria-label="toggle items in Reference category" aria-pressed="false"> <svg viewBox="0 0 24 24" aria-hidden="true"><use xlink:href="#svg-arrow-right"></use></svg> </button><a href="/reference/" class="nav-list-link">Reference</a><ul class="nav-list"><li class="nav-list-item"><a href="/reference/api/" class="nav-list-link">API</a></li><li class="nav-list-item"><a href="/reference/glossary/" class="nav-list-link">Glossary</a></li></ul></li><li class="nav-list-item"><a href="/" class="nav-list-link">Home</a></li></ul> </nav> <footer class="site-footer"> This site uses <a href="https://github.com/just-the-docs/just-the-docs">Just the Docs</a>, a documentation theme for Jekyll. </footer> </div> <div class="main" id="top"> <div id="main-header" class="main-header"> <div class="search" role="search"> <div class="search-input-wrap"> <input type="text" id="search-input" class="search-input" tabindex="0" placeholder="Search scheng" aria-label="Search scheng" autocomplete="off"> <label for="search-input" class="search-label"><svg viewBox="0 0 24 24" class="search-icon"><use xlink:href="#svg-search"></use></svg></label> </div> <div id="search-results" class="search-results"></div> </div> </div> <div class="main-content-wrap"> <div id="main-content" class="main-content"> <main> <h{"0": { "doc": "API", "title": "API Reference", "content": "Example commands and options. ", "url": "/reference/api/#api-reference", "relUrl": "/reference/api/#api-reference" },"1": { "doc": "API", "title": "my-tool init", "content": "my-tool init . ", "url": "/reference/api/#my-tool-init", "relUrl": "/reference/api/#my-tool-init" },"2": { "doc": "API", "title": "API", "content": " ", "url": "/reference/api/", "relUrl": "/reference/api/" },"3": { "doc": "Crate Map", "title": "Crate Map", "content": "This document defines the architectural boundaries of the ShadeCore / Schengine workspace. It describes where responsibilities live and, equally important, where they do not. This is not an API reference. It is a system ownership map. ", "url": "/sdk/crate-map/", "relUrl": "/sdk/crate-map/" },"4": { "doc": "Crate Map", "title": "Architectural Principles", "content": "The workspace is organized around strict separation of concerns: . | Topology (graph) | Configuration (NodeProps) | Execution (runtime) | GPU integration (runtime-glow) | Input/Output integration (edge crates) | . No crate should violate these boundaries. ", "url": "/sdk/crate-map/#architectural-principles", "relUrl": "/sdk/crate-map/#architectural-principles" },"5": { "doc": "Crate Map", "title": "Core Crates", "content": " ", "url": "/sdk/crate-map/#core-crates", "relUrl": "/sdk/crate-map/#core-crates" },"6": { "doc": "Crate Map", "title": "shadecore-core", "content": "Purpose: Defines foundational types and traits shared across the engine. Responsibilities: . | Shared identifiers (NodeId, etc.) | Core trait definitions | Minimal dependency surface | . Non-Responsibilities: . | No GL bindings | No windowing | No device access | No execution logic | . This crate must remain small and dependency-light. ", "url": "/sdk/crate-map/#shadecore-core", "relUrl": "/sdk/crate-map/#shadecore-core" },"7": { "doc": "Crate Map", "title": "shadecore-graph", "content": "Purpose: Defines graph topology and compilation. Responsibilities: . | Node instantiation | Port definitions | Connection wiring | Validation | Compilation into execution plans | . Non-Responsibilities: . | No shader compilation | No GPU resources | No runtime execution | No parameter mutation | . Graph is static topology only. ", "url": "/sdk/crate-map/#shadecore-graph", "relUrl": "/sdk/crate-map/#shadecore-graph" },"8": { "doc": "Crate Map", "title": "shadecore-runtime", "content": "Purpose: Defines abstract execution traits. Responsibilities: . | Execution interfaces | Plan execution contracts | Runtime behavior definitions (abstract) | . Non-Responsibilities: . | No concrete GL integration | No device management | . This crate defines what it means to execute a plan, without specifying how. ", "url": "/sdk/crate-map/#shadecore-runtime", "relUrl": "/sdk/crate-map/#shadecore-runtime" },"9": { "doc": "Crate Map", "title": "shadecore-runtime-glow", "content": "Purpose: Concrete OpenGL runtime implementation using glow. Responsibilities: . | Shader compilation | Program caching | Texture management | Framebuffer allocation | Per-frame execution | . Non-Responsibilities: . | No topology mutation | No control protocol parsing | No time ownership | . This crate is the GPU execution engine. ", "url": "/sdk/crate-map/#shadecore-runtime-glow", "relUrl": "/sdk/crate-map/#shadecore-runtime-glow" },"10": { "doc": "Crate Map", "title": "Input / Output Crates", "content": " ", "url": "/sdk/crate-map/#input--output-crates", "relUrl": "/sdk/crate-map/#input--output-crates" },"11": { "doc": "Crate Map", "title": "shadecore-input-video", "content": "Purpose: Video decoding and texture production. Responsibilities: . | External decode integration | JSON configuration loading | Texture delivery to graph | . Non-Responsibilities: . | No transport control | No engine time management | . ", "url": "/sdk/crate-map/#shadecore-input-video", "relUrl": "/sdk/crate-map/#shadecore-input-video" },"12": { "doc": "Crate Map", "title": "Integration Boundary", "content": "Platform-specific integrations (Syphon, Spout, capture, etc.) must: . | Live outside core crates | Treat runtime as a pure execution engine | Avoid injecting platform logic into engine internals | . ", "url": "/sdk/crate-map/#integration-boundary", "relUrl": "/sdk/crate-map/#integration-boundary" },"13": { "doc": "Crate Map", "title": "Stability Expectations", "content": "Core crates should change slowly. Runtime implementations may evolve, but must not break: . | Graph compilation guarantees | NodeProps contract | FrameCtx semantics | . This crate map is a contract between contributors. ", "url": "/sdk/crate-map/#stability-expectations", "relUrl": "/sdk/crate-map/#stability-expectations" },"14": { "doc": "Execution Model Internals", "title": "Execution Model Internals", "content": "This document defines the internal execution lifecycle of one frame. It describes what the engine does — and what it explicitly does not do. ", "url": "/sdk/execution-model/", "relUrl": "/sdk/execution-model/" },"15": { "doc": "Execution Model Internals", "title": "Frame Boundary", "content": "Each invocation of: . execute_plan_outputs(...) . represents exactly one frame. The runtime does not: . | Schedule frames | Manage vsync | Accumulate time | . All timing originates externally via FrameCtx. ", "url": "/sdk/execution-model/#frame-boundary", "relUrl": "/sdk/execution-model/#frame-boundary" },"16": { "doc": "Execution Model Internals", "title": "Internal Execution Steps", "content": "Given a compiled plan, execution proceeds: . | Read FrameCtx | Read NodeProps | Iterate nodes in deterministic topological order | For each node: . | Resolve input textures | Bind shader program | Set uniforms | Issue draw call | . | Write final outputs | . No graph mutation occurs during execution. ", "url": "/sdk/execution-model/#internal-execution-steps", "relUrl": "/sdk/execution-model/#internal-execution-steps" },"17": { "doc": "Execution Model Internals", "title": "Determinism", "content": "For identical: . | Graph topology | NodeProps state | FrameCtx values | . Execution order and resource usage are deterministic (subject to deterministic shaders). ", "url": "/sdk/execution-model/#determinism", "relUrl": "/sdk/execution-model/#determinism" },"18": { "doc": "Execution Model Internals", "title": "Resource Lifecycle", "content": "Resources are managed lazily: . | Shaders compile on first use | Programs are cached per node | Textures/FBOs allocated on demand | Reused across frames | . Reallocation occurs only if: . | Resolution changes | Shader source changes | Node configuration invalidates cache | . ", "url": "/sdk/execution-model/#resource-lifecycle", "relUrl": "/sdk/execution-model/#resource-lifecycle" },"19": { "doc": "Execution Model Internals", "title": "Error Handling", "content": "Errors surface immediately and are returned to the caller. Common error classes: . | Shader compile/link failure | Missing required configuration | GL context absence | Invalid bindings | . The runtime does not attempt silent recovery. ", "url": "/sdk/execution-model/#error-handling", "relUrl": "/sdk/execution-model/#error-handling" },"20": { "doc": "Execution Model Internals", "title": "Threading Assumptions", "content": ". | Execution must occur on a thread with a current GL context. | The runtime is single-threaded internally. | External synchronization is the caller’s responsibility. | . Violating these assumptions results in undefined behavior. ", "url": "/sdk/execution-model/#threading-assumptions", "relUrl": "/sdk/execution-model/#threading-assumptions" },"21": { "doc": "Execution Model Internals", "title": "Design Guarantee", "content": "The runtime is a deterministic execution engine. It is not: . | A scheduler | A transport controller | A device manager | . ", "url": "/sdk/execution-model/#design-guarantee", "relUrl": "/sdk/execution-model/#design-guarantee" },"22": { "doc": "Frame Context (`FrameCtx`)", "title": "Frame Context (FrameCtx)", "content": "FrameCtx defines the complete, immutable execution context for a single frame of graph execution. It is the only global, per-frame input provided to the runtime. ", "url": "/sdk/frame-ctx/#frame-context-framectx", "relUrl": "/sdk/frame-ctx/#frame-context-framectx" },"23": { "doc": "Frame Context (`FrameCtx`)", "title": "Role in the System", "content": "FrameCtx establishes: . | Render dimensions | Temporal position | Frame identity | . The runtime does not maintain internal time, frame counters, or implicit scheduling. All temporal semantics originate from FrameCtx. ", "url": "/sdk/frame-ctx/#role-in-the-system", "relUrl": "/sdk/frame-ctx/#role-in-the-system" },"24": { "doc": "Frame Context (`FrameCtx`)", "title": "Data Structure", "content": "pub struct FrameCtx { pub width: u32, pub height: u32, pub time: f32, pub frame: u64, } . ", "url": "/sdk/frame-ctx/#data-structure", "relUrl": "/sdk/frame-ctx/#data-structure" },"25": { "doc": "Frame Context (`FrameCtx`)", "title": "Field Semantics", "content": "width / height . Defines the target render resolution for the frame. Effects: . | Sets viewport dimensions | Propagates to shader uniform uResolution | Determines render target allocation size | . Changing resolution between frames is allowed but may cause internal resource reallocation. time . Floating-point time value in seconds. The runtime: . | Forwards this value to shaders (uTime) | Does not interpret or constrain it | Does not enforce monotonicity | . Valid patterns: . | Monotonic wall-clock progression | Manual scrubbing | Looping time domains | Discontinuous jumps | . frame . Unsigned frame index. The runtime: . | Forwards this value to shaders (uFrame) | Does not enforce increment rules | Does not derive timing from it | . Used for deterministic frame identity and debugging. ", "url": "/sdk/frame-ctx/#field-semantics", "relUrl": "/sdk/frame-ctx/#field-semantics" },"26": { "doc": "Frame Context (`FrameCtx`)", "title": "Guarantees", "content": ". | Immutable during execution | Stable for the duration of a frame | No hidden time accumulation in the runtime | No implicit scheduler dependency | . ", "url": "/sdk/frame-ctx/#guarantees", "relUrl": "/sdk/frame-ctx/#guarantees" },"27": { "doc": "Frame Context (`FrameCtx`)", "title": "Failure Modes", "content": "Improper usage may result in: . | Shader logic misbehavior (if time assumptions are violated) | Resource churn (if resolution fluctuates excessively) | Non-deterministic results (if frame/time values are inconsistent) | . ", "url": "/sdk/frame-ctx/#failure-modes", "relUrl": "/sdk/frame-ctx/#failure-modes" },"28": { "doc": "Frame Context (`FrameCtx`)", "title": "Design Rationale", "content": "Separating frame context from runtime state ensures: . | Deterministic execution | Replayability | Offline rendering capability | Explicit time control | . The engine never owns time. ", "url": "/sdk/frame-ctx/#design-rationale", "relUrl": "/sdk/frame-ctx/#design-rationale" },"29": { "doc": "Frame Context (`FrameCtx`)", "title": "Frame Context (`FrameCtx`)", "content": " ", "url": "/sdk/frame-ctx/", "relUrl": "/sdk/frame-ctx/" },"30": { "doc": "Getting Started", "title": "Getting Started", "content": "This page walks you through setting up a local environment and running your first scheng instrument. ", "url": "/getting-started/", "relUrl": "/getting-started/" },"31": { "doc": "Getting Started", "title": "Audience", "content": "Use this page if you want to: . | Build scheng from source | Run the included example instruments | Confirm your environment is ready before diving into Guides and Patterns | . ", "url": "/getting-started/#audience", "relUrl": "/getting-started/#audience" },"32": { "doc": "Getting Started", "title": "Prerequisites", "content": "Required: . | Rust toolchain (stable) | Cargo (installed with Rust) | Git | A GPU with modern OpenGL support | Up-to-date graphics drivers | . Verify Rust and Cargo: . rustc --version cargo --version . ", "url": "/getting-started/#prerequisites", "relUrl": "/getting-started/#prerequisites" },"33": { "doc": "Getting Started", "title": "Clone the Repository", "content": "git clone &lt;repo-url&gt; cd scheng . Replace &lt;repo-url&gt; with the actual Git repository URL. ", "url": "/getting-started/#clone-the-repository", "relUrl": "/getting-started/#clone-the-repository" },"34": { "doc": "Getting Started", "title": "Build the Workspace", "content": "cargo build --workspace . A successful build confirms: . | All dependencies resolve | The workspace compiles cleanly | Core crates build without errors | . If this step fails, resolve build errors before proceeding. ", "url": "/getting-started/#build-the-workspace", "relUrl": "/getting-started/#build-the-workspace" },"35": { "doc": "Getting Started", "title": "Run an Example Instrument", "content": "Example: . cargo run -p shadecore-example-minimal . On success: . | A window opens | Frames render | No runtime panics occur | . ", "url": "/getting-started/#run-an-example-instrument", "relUrl": "/getting-started/#run-an-example-instrument" },"36": { "doc": "Getting Started", "title": "Validate Runtime Behavior", "content": "While running: . | Confirm stable frame updates | Test any mapped controls (keyboard, OSC, etc.) | Check terminal output for warnings or shader errors | . ", "url": "/getting-started/#validate-runtime-behavior", "relUrl": "/getting-started/#validate-runtime-behavior" },"37": { "doc": "Getting Started", "title": "Troubleshooting", "content": "Build Errors . cargo clean cargo build --workspace . Ensure you are using the stable Rust toolchain. Blank or Black Window . | Check for shader compile/link errors in the terminal | Verify GPU compatibility | Confirm required assets are present | . ", "url": "/getting-started/#troubleshooting", "relUrl": "/getting-started/#troubleshooting" },"38": { "doc": "Getting Started", "title": "Next Steps", "content": "After a successful run: . | Review the Project Overview (home page) | Explore Examples | Read Guides for structured workflows | . ", "url": "/getting-started/#next-steps", "relUrl": "/getting-started/#next-steps" },"39": { "doc": "Glossary", "title": "Glossary", "content": "This glossary defines the canonical terminology used throughout the ShadeCore SDK documentation. The definitions here are authoritative. If a term is used in SDK, Internals, or Patterns documentation, it should align with this glossary. ", "url": "/reference/glossary/", "relUrl": "/reference/glossary/" },"40": { "doc": "Glossary", "title": "Core Architectural Terms", "content": " ", "url": "/reference/glossary/#core-architectural-terms", "relUrl": "/reference/glossary/#core-architectural-terms" },"41": { "doc": "Glossary", "title": "Instrument", "content": "A user-defined application built on top of the ShadeCore engine. An instrument is responsible for: . | Constructing the Graph | Supplying NodeProps | Supplying FrameCtx | Handling control input (OSC, MIDI, etc.) | Managing external textures or devices | . The engine does not define instruments. Instruments define themselves around the engine. ", "url": "/reference/glossary/#instrument", "relUrl": "/reference/glossary/#instrument" },"42": { "doc": "Glossary", "title": "Engine", "content": "The collective core crates that define: . | Graph topology | Runtime execution | GPU integration | . The engine is deterministic and execution-focused. It does not own time, control protocols, or device management. ", "url": "/reference/glossary/#engine", "relUrl": "/reference/glossary/#engine" },"43": { "doc": "Glossary", "title": "Graph", "content": "The static topology describing how nodes connect. The graph defines: . | Nodes | Ports | Directed connections | Acyclic data flow | . The graph does not define behavior. It defines structure. ", "url": "/reference/glossary/#graph", "relUrl": "/reference/glossary/#graph" },"44": { "doc": "Glossary", "title": "Execution Plan", "content": "An immutable, compiled representation of a Graph. Produced by calling compile(). The execution plan defines: . | Deterministic node order | Validated connections | Runtime-ready topology | . The plan cannot be modified once compiled. ", "url": "/reference/glossary/#execution-plan", "relUrl": "/reference/glossary/#execution-plan" },"45": { "doc": "Glossary", "title": "Node", "content": "A single unit of computation inside the graph. A node may: . | Produce textures | Transform textures | Combine textures | Write final outputs | . Nodes do not own time or control state. ", "url": "/reference/glossary/#node", "relUrl": "/reference/glossary/#node" },"46": { "doc": "Glossary", "title": "NodeId", "content": "An opaque identifier assigned by the Graph. Used as the key into: . | NodeProps | Shader bindings | Parameter maps | . NodeId is stable for the lifetime of a graph instance. ", "url": "/reference/glossary/#nodeid", "relUrl": "/reference/glossary/#nodeid" },"47": { "doc": "Glossary", "title": "NodeProps", "content": "The complete configuration surface for nodes. NodeProps supplies: . | Shader sources | Mixer parameters | Video configuration | Texture bindings | Output naming | . NodeProps is owned by the instrument and read by the runtime. ", "url": "/reference/glossary/#nodeprops", "relUrl": "/reference/glossary/#nodeprops" },"48": { "doc": "Glossary", "title": "FrameCtx", "content": "The immutable per-frame execution context. Contains: . | width | height | time | frame | . The engine does not generate or mutate FrameCtx. ", "url": "/reference/glossary/#framectx", "relUrl": "/reference/glossary/#framectx" },"49": { "doc": "Glossary", "title": "Runtime", "content": "The component that executes a compiled plan for one frame. The runtime: . | Reads NodeProps | Reads FrameCtx | Binds resources | Dispatches draw calls | Produces outputs | . The runtime is not a scheduler. ", "url": "/reference/glossary/#runtime", "relUrl": "/reference/glossary/#runtime" },"50": { "doc": "Glossary", "title": "Runtime Implementation", "content": "A concrete execution backend. Example: . | shadecore-runtime-glow | . Responsible for: . | Shader compilation | GL resource management | Texture allocation | Framebuffer management | . ", "url": "/reference/glossary/#runtime-implementation", "relUrl": "/reference/glossary/#runtime-implementation" },"51": { "doc": "Glossary", "title": "GPU &amp; Rendering Terms", "content": " ", "url": "/reference/glossary/#gpu--rendering-terms", "relUrl": "/reference/glossary/#gpu--rendering-terms" },"52": { "doc": "Glossary", "title": "ShaderPass", "content": "A processing node that executes a GLSL program over input textures. Used for: . | Effects | Transformations | Post-processing | . ", "url": "/reference/glossary/#shaderpass", "relUrl": "/reference/glossary/#shaderpass" },"53": { "doc": "Glossary", "title": "Mixer", "content": "A node that combines multiple input textures into one output. Mixing semantics are defined entirely by the shader. The engine does not impose RGB or channel semantics. ", "url": "/reference/glossary/#mixer", "relUrl": "/reference/glossary/#mixer" },"54": { "doc": "Glossary", "title": "Uniform", "content": "A shader parameter supplied by the runtime. Standard uniforms include: . | uResolution | uTime | uFrame | . Custom uniforms must be supplied via NodeProps. ", "url": "/reference/glossary/#uniform", "relUrl": "/reference/glossary/#uniform" },"55": { "doc": "Glossary", "title": "Sampler Binding", "content": "The mapping between a graph input texture and a shader sampler uniform. Sampler ordering is deterministic per node kind. ", "url": "/reference/glossary/#sampler-binding", "relUrl": "/reference/glossary/#sampler-binding" },"56": { "doc": "Glossary", "title": "Framebuffer (FBO)", "content": "A GPU render target used for intermediate or final outputs. Managed internally by the runtime implementation. ", "url": "/reference/glossary/#framebuffer-fbo", "relUrl": "/reference/glossary/#framebuffer-fbo" },"57": { "doc": "Glossary", "title": "Control &amp; Integration Terms", "content": " ", "url": "/reference/glossary/#control--integration-terms", "relUrl": "/reference/glossary/#control--integration-terms" },"58": { "doc": "Glossary", "title": "Control Layer", "content": "The instrument-level system that: . | Receives external messages (OSC, MIDI, etc.) | Maps values to parameters | Updates NodeProps | . The control layer is outside the engine. ", "url": "/reference/glossary/#control-layer", "relUrl": "/reference/glossary/#control-layer" },"59": { "doc": "Glossary", "title": "OSC Contract", "content": "The pattern by which OSC values are translated into parameter updates. The engine does not parse OSC directly. ", "url": "/reference/glossary/#osc-contract", "relUrl": "/reference/glossary/#osc-contract" },"60": { "doc": "Glossary", "title": "Texture Input", "content": "An externally created texture injected into the graph. Ownership model: . | Instrument owns the texture handle | Runtime consumes it during execution | . ", "url": "/reference/glossary/#texture-input", "relUrl": "/reference/glossary/#texture-input" },"61": { "doc": "Glossary", "title": "Transport", "content": "The time-control model implemented by the instrument. Examples: . | Play | Pause | Scrub | Loop | . Transport logic updates FrameCtx.time. ", "url": "/reference/glossary/#transport", "relUrl": "/reference/glossary/#transport" },"62": { "doc": "Glossary", "title": "Determinism &amp; Execution Terms", "content": " ", "url": "/reference/glossary/#determinism--execution-terms", "relUrl": "/reference/glossary/#determinism--execution-terms" },"63": { "doc": "Glossary", "title": "Deterministic Execution", "content": "For identical: . | Graph | NodeProps | FrameCtx | . The runtime produces identical execution order and resource bindings. Shader determinism depends on shader code. ", "url": "/reference/glossary/#deterministic-execution", "relUrl": "/reference/glossary/#deterministic-execution" },"64": { "doc": "Glossary", "title": "Lazy Compilation", "content": "Shader programs are compiled only on first use. Compiled programs are cached for reuse across frames. ", "url": "/reference/glossary/#lazy-compilation", "relUrl": "/reference/glossary/#lazy-compilation" },"65": { "doc": "Glossary", "title": "Hot Path", "content": "The per-frame execution path. Must avoid: . | Allocation | Shader recompilation | Blocking I/O | . ", "url": "/reference/glossary/#hot-path", "relUrl": "/reference/glossary/#hot-path" },"66": { "doc": "Glossary", "title": "Architectural Boundaries", "content": " ", "url": "/reference/glossary/#architectural-boundaries", "relUrl": "/reference/glossary/#architectural-boundaries" },"67": { "doc": "Glossary", "title": "Topology vs Configuration", "content": "Topology: . | Defined by Graph | Static after compile | . Configuration: . | Defined by NodeProps | Mutable between frames | . ", "url": "/reference/glossary/#topology-vs-configuration", "relUrl": "/reference/glossary/#topology-vs-configuration" },"68": { "doc": "Glossary", "title": "Engine vs Instrument", "content": "Engine: . | Deterministic executor | No protocol ownership | No device ownership | No time ownership | . Instrument: . | Owns time | Owns control | Owns external textures | Owns graph construction | . ", "url": "/reference/glossary/#engine-vs-instrument", "relUrl": "/reference/glossary/#engine-vs-instrument" },"69": { "doc": "Glossary", "title": "Non-Goals", "content": "The engine is not: . | A media player | A scheduler | A device manager | A protocol parser | . These responsibilities belong to the instrument layer. ", "url": "/reference/glossary/#non-goals", "relUrl": "/reference/glossary/#non-goals" },"70": { "doc": "Graph API", "title": "Graph API", "content": "The Graph API defines the topology of execution. It describes how nodes connect, not how they behave. ", "url": "/sdk/graph-api/", "relUrl": "/sdk/graph-api/" },"71": { "doc": "Graph API", "title": "Responsibilities", "content": "The graph: . | Creates node instances | Defines port layouts | Connects output ports to input ports | Validates topology | Compiles into an immutable execution plan | . ", "url": "/sdk/graph-api/#responsibilities", "relUrl": "/sdk/graph-api/#responsibilities" },"72": { "doc": "Graph API", "title": "Separation of Concerns", "content": "The graph does NOT define: . | Shader code | Parameter values | Execution timing | Control input | . Behavior is supplied via NodeProps and FrameCtx. ", "url": "/sdk/graph-api/#separation-of-concerns", "relUrl": "/sdk/graph-api/#separation-of-concerns" },"73": { "doc": "Graph API", "title": "Compilation Model", "content": "Calling compile() performs: . | Cycle detection | Port validation | Deterministic topological sorting | Plan construction | . The resulting plan is immutable. ", "url": "/sdk/graph-api/#compilation-model", "relUrl": "/sdk/graph-api/#compilation-model" },"74": { "doc": "Graph API", "title": "Determinism Guarantees", "content": "Given identical: . | Graph topology | NodeProps | FrameCtx | . Execution order and results are deterministic (assuming deterministic shaders). ", "url": "/sdk/graph-api/#determinism-guarantees", "relUrl": "/sdk/graph-api/#determinism-guarantees" },"75": { "doc": "Graph API", "title": "Failure Conditions", "content": "Compilation fails if: . | Ports are unconnected where required | Cycles exist | Invalid port names are referenced | . ", "url": "/sdk/graph-api/#failure-conditions", "relUrl": "/sdk/graph-api/#failure-conditions" },"76": { "doc": "Graph API", "title": "Design Principle", "content": "Topology is static. Configuration is dynamic. This separation enables high-performance per-frame execution. ", "url": "/sdk/graph-api/#design-principle", "relUrl": "/sdk/graph-api/#design-principle" },"77": { "doc": "Home", "title": "scheng", "content": "scheng is a Rust-based engine for GPU-accelerated video synthesis and real-time video instrument development. It provides a graph-based execution model, explicit shader and node contracts, and a modular SDK surface for building deterministic, extensible visual systems. ", "url": "/#scheng", "relUrl": "/#scheng" },"78": { "doc": "Home", "title": "Home", "content": " ", "url": "/", "relUrl": "/" },"79": { "doc": "SDK Reference", "title": "SDK Reference", "content": "API surface, contracts, and node-level details for the ShadeCore SDK. ", "url": "/sdk/", "relUrl": "/sdk/" },"80": { "doc": "Reference", "title": "Reference", "content": "Low-level reference documentation. ", "url": "/reference/", "relUrl": "/reference/" },"81": { "doc": "Known Constraints and Non-Goals", "title": "Known Constraints and Non-Goals", "content": "This document records intentional architectural constraints. These are not limitations by accident — they are design decisions. ", "url": "/sdk/known-constraints/", "relUrl": "/sdk/known-constraints/" },"82": { "doc": "Known Constraints and Non-Goals", "title": "Time and Transport", "content": "Constraint: The engine does not own time. Implication: . | No play/pause inside core crates | No internal frame clock | No transport logic in runtime | . All transport semantics belong to the instrument layer. ", "url": "/sdk/known-constraints/#time-and-transport", "relUrl": "/sdk/known-constraints/#time-and-transport" },"83": { "doc": "Known Constraints and Non-Goals", "title": "Control Protocols", "content": "Constraint: The engine is protocol-agnostic. Implication: . | No OSC parsing in core crates | No MIDI handling in runtime | No network socket management | . Control values enter via NodeProps only. ", "url": "/sdk/known-constraints/#control-protocols", "relUrl": "/sdk/known-constraints/#control-protocols" },"84": { "doc": "Known Constraints and Non-Goals", "title": "Device Management", "content": "Constraint: Devices are external concerns. Implication: . | No webcam enumeration in runtime | No OS-specific capture APIs in engine | No platform-specific code in core crates | . Engine consumes textures — it does not manage hardware. ", "url": "/sdk/known-constraints/#device-management", "relUrl": "/sdk/known-constraints/#device-management" },"85": { "doc": "Known Constraints and Non-Goals", "title": "Node Proliferation", "content": "Constraint: Node kinds must remain minimal. Implication: . | Prefer shader extensibility over new node types | Avoid duplicating node categories | Maintain stable execution semantics | . ", "url": "/sdk/known-constraints/#node-proliferation", "relUrl": "/sdk/known-constraints/#node-proliferation" },"86": { "doc": "Known Constraints and Non-Goals", "title": "Performance Constraints", "content": ". | Avoid per-frame allocation in hot paths | Avoid shader recompilation per frame | Avoid hidden resource churn | . Instrument-level design should be optimized before engine changes. ", "url": "/sdk/known-constraints/#performance-constraints", "relUrl": "/sdk/known-constraints/#performance-constraints" },"87": { "doc": "Known Constraints and Non-Goals", "title": "Contributor Guidance", "content": "When proposing changes: . Ask: . | Does this belong in topology? | Does this belong in configuration? | Does this belong in runtime? | Or does this belong in the instrument layer? | . If the answer is unclear, default to instrument-level implementation. ", "url": "/sdk/known-constraints/#contributor-guidance", "relUrl": "/sdk/known-constraints/#contributor-guidance" },"88": { "doc": "Known Constraints and Non-Goals", "title": "Core Principle", "content": "The engine remains small, deterministic, and execution-focused. Behavior belongs at the edges. ", "url": "/sdk/known-constraints/#core-principle", "relUrl": "/sdk/known-constraints/#core-principle" },"89": { "doc": "Node Kinds", "title": "Node Kinds", "content": "Node kinds define execution roles within the graph. Each kind establishes: . | Port configuration | Expected inputs | Expected outputs | Runtime behavior category | . ", "url": "/sdk/node-kinds/", "relUrl": "/sdk/node-kinds/" },"90": { "doc": "Node Kinds", "title": "Source Nodes", "content": "Produce textures without upstream dependencies. Examples: . | Video decode nodes | Webcam input | Procedural generators | . Guarantee: At least one output texture per frame (unless external failure). ", "url": "/sdk/node-kinds/#source-nodes", "relUrl": "/sdk/node-kinds/#source-nodes" },"91": { "doc": "Node Kinds", "title": "Processing Nodes", "content": "Transform input textures to a new output. Examples: . | ShaderPass | Color transforms | Post-processing effects | . Guarantee: Pure transformation given deterministic shader and inputs. ", "url": "/sdk/node-kinds/#processing-nodes", "relUrl": "/sdk/node-kinds/#processing-nodes" },"92": { "doc": "Node Kinds", "title": "Mixer Nodes", "content": "Combine multiple textures into a single output. Characteristics: . | Fixed input count per node type | Semantics defined by shader | Parameters supplied via NodeProps | . ", "url": "/sdk/node-kinds/#mixer-nodes", "relUrl": "/sdk/node-kinds/#mixer-nodes" },"93": { "doc": "Node Kinds", "title": "Output Nodes", "content": "Terminal nodes that write results to: . | Framebuffers | Named outputs | Readback buffers | . They do not produce further graph outputs. ", "url": "/sdk/node-kinds/#output-nodes", "relUrl": "/sdk/node-kinds/#output-nodes" },"94": { "doc": "Node Kinds", "title": "Extensibility Guidance", "content": "Prefer: . | New shaders | New configuration parameters | . Avoid: . | Introducing new node kinds unless execution semantics require it | . ", "url": "/sdk/node-kinds/#extensibility-guidance", "relUrl": "/sdk/node-kinds/#extensibility-guidance" },"95": { "doc": "NodeProps Reference", "title": "NodeProps Reference", "content": "NodeProps is the complete configuration surface for node behavior. All dynamic behavior flows through this structure. ", "url": "/sdk/node-props/", "relUrl": "/sdk/node-props/" },"96": { "doc": "NodeProps Reference", "title": "Ownership Model", "content": ". | Owned by the caller | Read-only during execution | Not mutated by the runtime | . This ensures predictable frame execution. ", "url": "/sdk/node-props/#ownership-model", "relUrl": "/sdk/node-props/#ownership-model" },"97": { "doc": "NodeProps Reference", "title": "Responsibilities", "content": "NodeProps supplies: . | Shader sources | Parameter values | Mixer weights | Video decode configuration | External texture bindings | Output naming | . ", "url": "/sdk/node-props/#responsibilities", "relUrl": "/sdk/node-props/#responsibilities" },"98": { "doc": "NodeProps Reference", "title": "Runtime Interaction", "content": "During execution: . | Runtime reads relevant entries by NodeId | Binds shader programs | Sets uniforms | Executes draw calls | . No hidden state persists inside nodes. ", "url": "/sdk/node-props/#runtime-interaction", "relUrl": "/sdk/node-props/#runtime-interaction" },"99": { "doc": "NodeProps Reference", "title": "Update Semantics", "content": "Changes to NodeProps: . | Take effect on the next frame | Do not invalidate compiled topology | May trigger shader recompilation if source changes | . ", "url": "/sdk/node-props/#update-semantics", "relUrl": "/sdk/node-props/#update-semantics" },"100": { "doc": "NodeProps Reference", "title": "Failure Modes", "content": "Incorrect configuration may result in: . | Shader compile errors | Missing input bindings | Undefined uniform values | . Errors are surfaced to the caller. ", "url": "/sdk/node-props/#failure-modes", "relUrl": "/sdk/node-props/#failure-modes" },"101": { "doc": "OSC Contract", "title": "OSC Contract", "content": "The OSC Contract defines how control values enter the instrument layer. The runtime remains transport-agnostic. ", "url": "/sdk/osc-contract/", "relUrl": "/sdk/osc-contract/" },"102": { "doc": "OSC Contract", "title": "Control Flow", "content": ". | Receive OSC externally | Parse address/value | Map to parameters | Update NodeProps | . ", "url": "/sdk/osc-contract/#control-flow", "relUrl": "/sdk/osc-contract/#control-flow" },"103": { "doc": "OSC Contract", "title": "Guarantees", "content": ". | No protocol dependency in core engine | Latest value wins | No implicit interpolation | . ", "url": "/sdk/osc-contract/#guarantees", "relUrl": "/sdk/osc-contract/#guarantees" },"104": { "doc": "OSC Contract", "title": "Responsibility Boundary", "content": "Application layer handles: . | Socket lifecycle | Message parsing | Validation | Value mapping | . Runtime handles: . | Reading updated parameters | . ", "url": "/sdk/osc-contract/#responsibility-boundary", "relUrl": "/sdk/osc-contract/#responsibility-boundary" },"105": { "doc": "OSC Contract", "title": "Recommended Practices", "content": ". | Clamp values explicitly | Log parameter updates | Avoid blocking in control handlers | . ", "url": "/sdk/osc-contract/#recommended-practices", "relUrl": "/sdk/osc-contract/#recommended-practices" },"106": { "doc": "Overview", "title": "Overview", "content": "scheng enables developers to construct programmable video instruments using: . | Directed signal graphs | GPU shader execution | Real-time parameter control | Structured runtime planning | . Rather than being a fixed VJ application, scheng is an engine and SDK for building custom instruments with predictable execution behavior. It provides a graph-based execution model, explicit shader and node contracts, and a modular SDK surface for building deterministic, extensible visual systems. ", "url": "/overview/", "relUrl": "/overview/" },"107": { "doc": "Overview", "title": "Architecture at a Glance", "content": "scheng is organized as a multi-crate workspace separating core responsibilities: . | Graph Layer Declarative signal topology and node relationships. | Runtime Layer Frame planning and deterministic execution. | Shader Contracts Explicit interfaces between nodes and GPU forms. | Control Inputs OSC, keyboard, transport, and external state. | Output Targets Render targets and external integrations. | . Each layer is intentionally isolated to enforce clarity, extensibility, and real-time safety. ", "url": "/overview/#architecture-at-a-glance", "relUrl": "/overview/#architecture-at-a-glance" },"108": { "doc": "Overview", "title": "Core Concepts", "content": "Graph A declarative structure defining signal flow between nodes. Node A unit of execution implementing a defined contract. Nodes consume and produce textures. Instrument An executable built on the scheng SDK that wires graph, runtime, and controls. Runtime The system responsible for frame scheduling and dispatch. Transport Time and playback control propagation through the graph. Control Surface External systems that modify node parameters in real time. ", "url": "/overview/#core-concepts", "relUrl": "/overview/#core-concepts" },"109": { "doc": "Overview", "title": "Design Principles", "content": ". | Explicit execution contracts | Clear separation of concerns | Deterministic frame behavior | Extensibility without runtime modification | GPU-first architecture | . ", "url": "/overview/#design-principles", "relUrl": "/overview/#design-principles" },"110": { "doc": "Overview", "title": "What scheng Is Not", "content": "scheng is not: . | A GUI-based patch editor | A turnkey VJ application | A video editing suite | A high-level scripting framework | . It is a programmable engine for constructing video instruments. ", "url": "/overview/#what-scheng-is-not", "relUrl": "/overview/#what-scheng-is-not" },"111": { "doc": "Runtime Execution", "title": "Runtime Execution", "content": "The runtime executes a compiled graph for one frame. It is a deterministic execution engine, not a scheduler. ", "url": "/sdk/runtime-execution/", "relUrl": "/sdk/runtime-execution/" },"112": { "doc": "Runtime Execution", "title": "Responsibilities", "content": ". | Execute nodes in topologically sorted order | Bind resources | Dispatch shader programs | Produce output textures | . ", "url": "/sdk/runtime-execution/#responsibilities", "relUrl": "/sdk/runtime-execution/#responsibilities" },"113": { "doc": "Runtime Execution", "title": "Execution Model", "content": "Each call: . | Accepts FrameCtx | Reads NodeProps | Executes compiled plan | Returns outputs | . No implicit time accumulation occurs. ", "url": "/sdk/runtime-execution/#execution-model", "relUrl": "/sdk/runtime-execution/#execution-model" },"114": { "doc": "Runtime Execution", "title": "Resource Management", "content": ". | Lazy shader compilation | Per-node resource caching | Texture reuse across frames | . ", "url": "/sdk/runtime-execution/#resource-management", "relUrl": "/sdk/runtime-execution/#resource-management" },"115": { "doc": "Runtime Execution", "title": "Threading Model", "content": "Requires active GL context on calling thread. No internal multithreading is performed. ", "url": "/sdk/runtime-execution/#threading-model", "relUrl": "/sdk/runtime-execution/#threading-model" },"116": { "doc": "Runtime Execution", "title": "Error Model", "content": "Execution may fail due to: . | Shader compile/link errors | Missing inputs | Invalid output configuration | . Errors are returned immediately. ", "url": "/sdk/runtime-execution/#error-model", "relUrl": "/sdk/runtime-execution/#error-model" },"117": { "doc": "SDK Overview", "title": "SDK Overview", "content": "The scheng SDK defines the public surface for building video instruments on top of the scheng engine. It provides the contracts, types, and execution interfaces required to construct graph-based, GPU-accelerated visual systems. This document describes the role, structure, and boundaries of the SDK. ", "url": "/sdk/", "relUrl": "/sdk/" },"118": { "doc": "SDK Overview", "title": "Purpose", "content": "The SDK exists to: . | Define stable interfaces between graph, runtime, and shader layers | Enforce explicit execution contracts | Enable instrument development without modifying core engine internals | Provide predictable, deterministic runtime behavior | . The SDK is the supported extension surface of scheng. ", "url": "/sdk/#purpose", "relUrl": "/sdk/#purpose" },"119": { "doc": "SDK Overview", "title": "Scope", "content": "The SDK includes: . | Graph construction APIs | Node contract definitions | Runtime execution interfaces | Shader form contracts | NodeProps and parameter surfaces | Control propagation structures (e.g., OSC integration points) | . The SDK does not include: . | Internal runtime scheduling details | GPU driver abstractions | Private engine state | Experimental or unstable internal utilities | . For engine implementation details, see Internals. ", "url": "/sdk/#scope", "relUrl": "/sdk/#scope" },"120": { "doc": "SDK Overview", "title": "Architecture Model", "content": "At a high level, the SDK sits between instrument code and engine execution. Instrument Code → SDK Contracts → Runtime Execution → GPU Shader Execution . The SDK defines: . | How nodes are declared | How parameters are structured | How frame context is passed | How shaders are registered and invoked | How execution is triggered per frame | . ", "url": "/sdk/#architecture-model", "relUrl": "/sdk/#architecture-model" },"121": { "doc": "SDK Overview", "title": "Core Components", "content": "Graph API . Defines how nodes and edges are declared and connected. Responsibilities: . | Node instantiation | Texture routing | Graph topology validation | . Node Contracts . Each node must implement a defined execution contract. Responsibilities: . | Define input/output texture expectations | Expose configurable parameters | Execute per-frame logic safely | . NodeProps . Defines parameter surfaces for nodes. Responsibilities: . | Store runtime-modifiable values | Provide default configuration | Maintain deterministic parameter state | . NodeProps are the boundary between control inputs and execution logic. Runtime Execution Interface . Defines how frames are planned and dispatched. Responsibilities: . | Accept graph definitions | Prepare execution plans | Invoke node execution in correct order | Maintain frame context | . The runtime does not define shader behavior. It coordinates execution. Shader Contract . Defines the interface between node logic and GPU shader forms. Responsibilities: . | Uniform bindings | Texture inputs | Output target definitions | Explicit parameter mapping | . Shader contracts must remain consistent to preserve execution guarantees. ", "url": "/sdk/#core-components", "relUrl": "/sdk/#core-components" },"122": { "doc": "SDK Overview", "title": "Stability Guarantees", "content": "Public SDK APIs are considered stable unless explicitly documented otherwise. Changes that affect: . | Node contract signatures | Frame context structures | Shader uniform expectations | . are considered breaking and must be versioned appropriately. ", "url": "/sdk/#stability-guarantees", "relUrl": "/sdk/#stability-guarantees" },"123": { "doc": "SDK Overview", "title": "Extension Model", "content": "To extend scheng using the SDK: . | Create new nodes implementing the required contract | Register new shader forms | Extend NodeProps for parameter exposure | Wire graph topology explicitly | . The SDK allows feature growth without modifying runtime internals. ", "url": "/sdk/#extension-model", "relUrl": "/sdk/#extension-model" },"124": { "doc": "SDK Overview", "title": "Design Principles", "content": ". | Explicit over implicit | Deterministic frame execution | Clear boundary between graph and runtime | GPU-first architecture | Minimal hidden state | . ", "url": "/sdk/#design-principles", "relUrl": "/sdk/#design-principles" },"125": { "doc": "SDK Overview", "title": "When to Use the SDK Reference", "content": "Use the SDK Reference when: . | Implementing new nodes | Registering shader forms | Modifying parameter surfaces | Investigating execution flow | Ensuring contract correctness | . For conceptual explanations and workflows, see Guides. For internal engine mechanics, see Internals. ", "url": "/sdk/#when-to-use-the-sdk-reference", "relUrl": "/sdk/#when-to-use-the-sdk-reference" },"126": { "doc": "Shader Contract", "title": "Shader Contract", "content": "Defines the interface between runtime and GLSL programs. ", "url": "/sdk/shader-contract/", "relUrl": "/sdk/shader-contract/" },"127": { "doc": "Shader Contract", "title": "Engine Guarantees", "content": "The runtime guarantees: . | Valid GL context | Bound textures | Standard uniforms: . | uResolution | uTime | uFrame | . | Deterministic sampler ordering | . ", "url": "/sdk/shader-contract/#engine-guarantees", "relUrl": "/sdk/shader-contract/#engine-guarantees" },"128": { "doc": "Shader Contract", "title": "Shader Responsibilities", "content": "Shaders must: . | Compile under supported GLSL version | Write valid output color | Respect provided sampler bindings | . ", "url": "/sdk/shader-contract/#shader-responsibilities", "relUrl": "/sdk/shader-contract/#shader-responsibilities" },"129": { "doc": "Shader Contract", "title": "Custom Uniforms", "content": "Must be supplied via NodeProps. Missing values may produce undefined results. ", "url": "/sdk/shader-contract/#custom-uniforms", "relUrl": "/sdk/shader-contract/#custom-uniforms" },"130": { "doc": "Shader Contract", "title": "Compilation Model", "content": ". | Compiled lazily | Cached per node | Recompiled only when source changes | . ", "url": "/sdk/shader-contract/#compilation-model", "relUrl": "/sdk/shader-contract/#compilation-model" },"131": { "doc": "Shader Contract", "title": "Design Boundary", "content": "Engine controls execution. Shaders control visual behavior. ", "url": "/sdk/shader-contract/#design-boundary", "relUrl": "/sdk/shader-contract/#design-boundary" } } </main> </div> </div> <div class="search-overlay"></div> </div> </body> </html>
